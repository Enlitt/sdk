{
  "description": "Carries an assistant tool call followed by its tool result.",
  "endpoint": "create-response",
  "valid": true,
  "body": {
    "model": "enlitt-standard",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "What is the weather?"
          }
        ]
      },
      {
        "role": "assistant",
        "tool_calls": [
          {
            "id": "call_weather",
            "name": "weather",
            "arguments": "{\"city\":\"Boston\"}"
          }
        ]
      },
      {
        "role": "tool",
        "tool_call_id": "call_weather",
        "content": "Sunny"
      }
    ],
    "tools": [
      {
        "name": "weather",
        "description": "Gets the weather.",
        "input_schema": {
          "type": "object"
        }
      }
    ]
  }
}
