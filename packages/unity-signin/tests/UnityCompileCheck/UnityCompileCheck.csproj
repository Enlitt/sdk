<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Proves the Unity layer and the sample compile against a hand-written stub of the
    few UnityEngine members they use (UnityEngineStub.cs, with Unity's real signatures).
    There is no Unity editor here, so this does NOT prove the layer runs.
    C# 9 matches Unity 2021.3. Documentation warnings are errors under -warnaserror,
    so a public member without an XML comment fails the build.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Enlitt.SignIn</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../upm/Runtime/EnlittSignInCore.cs" Link="Runtime/EnlittSignInCore.cs" />
    <Compile Include="../../upm/Runtime/EnlittSignIn.cs" Link="Runtime/EnlittSignIn.cs" />
    <Compile Include="../../upm/Samples~/SignInButton/SignInButton.cs" Link="Samples/SignInButton.cs" />
  </ItemGroup>

</Project>
