{
  "name": "@enlitt/cli",
  "version": "0.1.0",
  "description": "Terminal client for an Enlitt business account, built to be driven by a coding agent",
  "homepage": "https://enlitt.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enlitt/sdk.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/enlitt/sdk/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "enlitt": "dist/bin.js"
  },
  "files": [
